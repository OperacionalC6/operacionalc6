# ==============================================================================
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA faça commit do arquivo ".env" (já está no .gitignore).
# Em produção, prefira um gerenciador de secrets (AWS Secrets Manager,
# Azure Key Vault, HashiCorp Vault, Doppler, etc.) em vez de arquivo .env.
# ==============================================================================

# --- Banco de dados ---
POSTGRES_USER=operacional_c6
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=operacional_c6
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Autenticação / JWT ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=troque-este-valor-por-um-segredo-forte-e-unico
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Login com Google ---
# ID do OAuth Client "Web application" criado no Google Cloud Console
# (console.cloud.google.com > APIs & Services > Credentials). O mesmo valor vai
# aqui e no frontend (NEXT_PUBLIC_GOOGLE_CLIENT_ID) — não é segredo, mas ainda
# assim não commitar aqui, cada ambiente tem o seu.
GOOGLE_OAUTH_CLIENT_ID=

# --- CORS / Frontend ---
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Fonte de dados: API Corban oficial (preferencial) ---
# Preencher somente após homologação junto ao C6 (ver docs/API_CORBAN.md).
DATA_SOURCE_MODE=portal_rpa   # "api_corban" | "portal_rpa"
C6_API_CORBAN_BASE_URL=
C6_API_CORBAN_CLIENT_ID=
C6_API_CORBAN_CLIENT_SECRET=

# --- Fonte de dados: RPA do portal WebAutorizador (fallback) ---
# Credenciais de um usuário dedicado à automação (não uma conta pessoal),
# solicitado formalmente ao C6/gestor de conta. Nunca reutilizar login pessoal.
C6_PORTAL_BASE_URL=https://c6.c6consig.com.br/WebAutorizador/Login/AC.UI.LOGIN.aspx
C6_PORTAL_USERNAME=
C6_PORTAL_PASSWORD=
# Se o portal exigir MFA, um TOTP secret pode ser configurado aqui (opcional).
C6_PORTAL_TOTP_SECRET=

# --- Agendamento do pipeline (cron, horário de Brasília) ---
# Padrão: 3x ao dia às 08:00, 13:00 e 18:00
PIPELINE_CRON_SCHEDULES=08:00,13:00,18:00
PIPELINE_TIMEZONE=America/Sao_Paulo

# --- Seed do primeiro usuário admin (usado só no primeiro start) ---
# Sem isso preenchido, NINGUÉM consegue logar (nem você) — é o e-mail que vira
# o primeiro registro autorizado em `users`. Use o Gmail de quem vai administrar.
ADMIN_EMAIL=

# --- Ambiente ---
ENVIRONMENT=development
LOG_LEVEL=INFO
