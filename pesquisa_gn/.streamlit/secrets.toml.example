# Copie este arquivo para .streamlit/secrets.toml (local) ou cole o conteúdo
# em "Settings > Secrets" no Streamlit Community Cloud.

# Senha do painel do gestor (OBRIGATÓRIO trocar)
ADMIN_PASSWORD = "troque-esta-senha"

# --- OPCIONAL: salvar respostas no Google Sheets ---------------------------
# Sem as linhas abaixo, as respostas vão para data/respostas.csv (arquivo local).
# Para ativar, tire o "#" das linhas, cole o conteúdo INTEIRO do arquivo .json
# da conta de serviço entre as ''' ''' e a URL da planilha.
# (GOOGLE_JSON precisa ficar ANTES da linha [gsheets].)
#
# GOOGLE_JSON = '''
# { cole aqui todo o conteúdo do arquivo .json, de { até } }
# '''
#
# [gsheets]
# spreadsheet_url = "https://docs.google.com/spreadsheets/d/SEU_ID/edit"
# worksheet = "Respostas"
